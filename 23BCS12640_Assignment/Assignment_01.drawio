  <diagram name="Step 6 - Production Ready" id="step6">
    <mxGraphModel dx="827" dy="418" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" value="STEP 6: PRODUCTION-READY ENTERPRISE ARCHITECTURE" vertex="1">
          <mxGeometry height="40" width="800" x="250" y="20" as="geometry" />
        </mxCell>

        <!-- EDGE LAYER (3 grouped boxes) -->
        <mxCell id="edge-security6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" value="Security Layer&#xa;WAF + DDoS Protection" vertex="1">
          <mxGeometry height="55" width="170" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-cdn6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" value="CDN + DNS&#xa;(CloudFront / Route 53)" vertex="1">
          <mxGeometry height="55" width="170" x="240" y="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-lb6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" value="Load Balancer + API Gateway&#xa;(Auto-scaling cluster)" vertex="1">
          <mxGeometry height="55" width="210" x="440" y="100" as="geometry" />
        </mxCell>

        <!-- APP LAYER (2 grouped service boxes) -->
        <mxCell id="app-core6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Core Services&#xa;&#xa;User · Exam · Question · Grading" vertex="1">
          <mxGeometry height="75" width="200" x="120" y="220" as="geometry" />
        </mxCell>
        <mxCell id="app-ext6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Extended Services&#xa;&#xa;Notification · Proctoring · Analytics · Reporting" vertex="1">
          <mxGeometry height="75" width="280" x="350" y="220" as="geometry" />
        </mxCell>

        <!-- EVENT BUS ROW -->
        <mxCell id="kafka6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=12;fontStyle=1;" value="Message Queue (Kafka)" vertex="1">
          <mxGeometry height="50" width="180" x="180" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ws6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;fontStyle=1;" value="WebSocket Cluster&#xa;(Real-time sync)" vertex="1">
          <mxGeometry height="50" width="180" x="400" y="370" as="geometry" />
        </mxCell>

        <!-- DATA LAYER (one grouped box) -->
        <mxCell id="data6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Data &amp; Storage Layer&#xa;&#xa;RDS Multi-AZ (Primary + Replicas) · Redis Cluster · S3 (cross-region)&#xa;Elasticsearch · Data Warehouse (Redshift)" vertex="1">
          <mxGeometry height="80" width="420" x="120" y="490" as="geometry" />
        </mxCell>

        <!-- DISASTER RECOVERY -->
        <mxCell id="dr6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;dashPattern=5 5;verticalAlign=top;fontStyle=1;" value="Region 2 – Disaster Recovery&#xa;&#xa;Standby infra · Auto failover&#xa;RTO &lt; 1 hr · RPO &lt; 5 min" vertex="1">
          <mxGeometry height="80" width="200" x="580" y="490" as="geometry" />
        </mxCell>

        <!-- MONITORING -->
        <mxCell id="monitor6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Observability &amp; Monitoring&#xa;&#xa;Prometheus/Grafana · ELK Logs · Jaeger Tracing · PagerDuty Alerts · APM" vertex="1">
          <mxGeometry height="65" width="400" x="140" y="620" as="geometry" />
        </mxCell>

        <!-- ── Edges ── -->
        <!-- Edge layer internal flow -->
        <mxCell id="e6-sec2cdn" edge="1" parent="1" source="edge-security6" target="edge-cdn6" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6-cdn2lb" edge="1" parent="1" source="edge-cdn6" target="edge-lb6" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- LB → App services -->
        <mxCell id="e6-lb2core" edge="1" parent="1" source="edge-lb6" target="app-core6" style="endArrow=classic;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6-lb2ext" edge="1" parent="1" source="edge-lb6" target="app-ext6" style="endArrow=classic;html=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- App → Event bus -->
        <mxCell id="e6-core2k" edge="1" parent="1" source="app-core6" target="kafka6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6-ext2ws" edge="1" parent="1" source="app-ext6" target="ws6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Event bus → Data -->
        <mxCell id="e6-k2data" edge="1" parent="1" source="kafka6" target="data6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6-ws2data" edge="1" parent="1" source="ws6" target="data6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.6;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Data → DR (replication) -->
        <mxCell id="e6-data2dr" edge="1" parent="1" source="data6" target="dr6" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" value="Replication">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Data → Monitoring -->
        <mxCell id="e6-data2mon" edge="1" parent="1" source="data6" target="monitor6" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Info boxes -->
        <mxCell id="feat6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=10;verticalAlign=top;" value="ENTERPRISE FEATURES:&lt;br&gt;&lt;br&gt;• Runs across 2 regions (survives outages)&lt;br&gt;• Auto-scales 2–10 app instances based on load&lt;br&gt;• WAF blocks attacks; CDN speeds up global access&lt;br&gt;• Full monitoring: metrics, logs, tracing, alerts&lt;br&gt;• Data warehouse for deep analytics&lt;br&gt;• AI-powered live proctoring&lt;br&gt;• Supports 100K+ users at once&lt;br&gt;&lt;br&gt;PERFORMANCE:&lt;br&gt;• API responses under 200 ms&lt;br&gt;• Automated backups + point-in-time recovery" vertex="1">
          <mxGeometry height="200" width="250" x="830" y="80" as="geometry" />
        </mxCell>
        <mxCell id="comp6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=10;verticalAlign=top;" value="COMPLIANCE &amp; SECURITY:&lt;br&gt;&lt;br&gt;• GDPR, FERPA, COPPA certified&lt;br&gt;• SOC 2 Type II · ISO 27001&lt;br&gt;• Encryption everywhere (at rest + in transit)&lt;br&gt;• Role-based access control (RBAC)&lt;br&gt;• MFA for all admin accounts&lt;br&gt;• Regular penetration testing" vertex="1">
          <mxGeometry height="160" width="250" x="830" y="320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
